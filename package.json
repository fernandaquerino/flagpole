{
  "name": "flagpole",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --passWithNoTests",
    "build": "pnpm -r build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @flagpole/api generate",
    "db:migrate": "node --env-file=.env scripts/run.mjs pnpm --filter @flagpole/api migrate",
    "db:seed": "node --env-file=.env scripts/run.mjs pnpm --filter @flagpole/api seed",
    "dev:api": "node --env-file=.env scripts/run.mjs pnpm --filter @flagpole/api dev",
    "test:integration": "node --env-file=.env scripts/run.mjs vitest run apps/api/test",
    "dev:example": "pnpm --filter @flagpole/example dev",
    "dev:web": "node --env-file=.env scripts/run.mjs pnpm --filter @flagpole/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.57.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "msw": "^2.12.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/dom": "^10.4.1",
    "jsdom": "^27.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
