    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@flagpole/shared": "workspace:*",
    "@flagpole/evaluator": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^6.19.0"
  }
}
