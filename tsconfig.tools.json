{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "vitest.config.ts",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/test/**/*.tsx",
    "apps/api/test/**/*.ts",
    "apps/api/e2e/**/*.ts"
  ]
}
